import admin from "firebase-admin";
import {ApiError} from "../middleware/errors";
import {FeatureSnapshot} from "../risk/contracts";

export function normalizeTronAddress(value: unknown): string {
  const address = String(value || "").trim();
  if (!/^T[1-9A-HJ-NP-Za-km-z]{33}$/.test(address)) {
    throw new ApiError(400, "INVALID_TRON_ADDRESS", "La dirección TRON no es válida.");
  }
  return address;
}

export function parseAsOf(value: unknown): number {
  if (value == null || value === "") return Date.now();
  const parsed = typeof value === "number" ? value : Date.parse(String(value));
  if (!Number.isFinite(parsed) || parsed <= 0 || parsed > Date.now() + 60_000) {
    throw new ApiError(400, "INVALID_AS_OF", "La fecha asOf no es válida.");
  }
  return parsed;
}

export async function getLatestSnapshot(
  db: admin.firestore.Firestore,
  address: string,
  asOfMs: number,
): Promise<FeatureSnapshot> {
  const query = await db.collection("ts_feature_snapshots")
    .where("address", "==", address)
    .where("snapshotAtMs", "<=", asOfMs)
    .orderBy("snapshotAtMs", "desc")
    .limit(1)
    .get();

  if (query.empty) {
    throw new ApiError(
      404,
      "SNAPSHOT_NOT_AVAILABLE",
      "No existe un snapshot histórico para la wallet y fecha solicitadas.",
    );
  }

  return query.docs[0].data() as FeatureSnapshot;
}
