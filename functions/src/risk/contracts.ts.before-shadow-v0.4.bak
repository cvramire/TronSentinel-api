export type RiskLevel = "LOW" | "MEDIUM" | "HIGH";
export type FeatureVector = Record<string, number>;

export interface ModelStump {
  feature: string;
  threshold: number;
  leftValue: number;
  rightValue: number;
}

export interface ModelMetrics {
  prAuc: number;
  recallHigh: number;
  precisionHigh?: number;
  brier: number;
  falsePositiveRate: number;
  sampleCount: number;
}

export interface TronSentinelModel {
  modelVersion: string;
  status: "CHALLENGER" | "CHAMPION" | "ARCHIVED";
  algorithm: "gradient_boosted_stumps_v1";
  featureSetVersion: string;
  labelVersion: string;
  horizonDays: number;
  featureNames: string[];
  baseLogit: number;
  learningRate: number;
  stumps: ModelStump[];
  calibrator: {
    type: "platt";
    a: number;
    b: number;
  };
  thresholds: {
    medium: number;
    high: number;
  };
  metrics: {
    baseline: ModelMetrics;
    backtest: ModelMetrics;
  };
  trainedFromMs: number;
  trainedToMs: number;
  createdAtMs: number;
  datasetHash: string;
}

export interface FeatureSnapshot {
  snapshotId: string;
  address: string;
  snapshotAtMs: number;
  featureSetVersion: string;
  features: FeatureVector;
}

export interface ClassifierResult {
  probability: number;
  score: number;
  riskLevel: RiskLevel;
  contributions: Array<{
    feature: string;
    contribution: number;
  }>;
}

export interface EntityScore extends ClassifierResult {
  address: string;
  asOf: string;
  snapshotAt: string;
  modelVersion: string;
  featureSetVersion: string;
  labelVersion: string;
  predictionHorizonDays: number;
}
