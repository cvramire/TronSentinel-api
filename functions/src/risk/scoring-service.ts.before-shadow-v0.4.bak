import admin from "firebase-admin";
import {ApiError} from "../middleware/errors";
import {getChampionModel} from "../repositories/model-repository";
import {recordPrediction} from "../repositories/prediction-repository";
import {
  getLatestSnapshot,
  normalizeTronAddress,
  parseAsOf,
} from "../repositories/snapshot-repository";
import {predict} from "./classifier";
import {EntityScore} from "./contracts";

export async function scoreWallet(
  db: admin.firestore.Firestore,
  input: {address: unknown; asOf?: unknown},
): Promise<EntityScore & {predictionId: string}> {
  const address = normalizeTronAddress(input.address);
  const asOfMs = parseAsOf(input.asOf);
  const [model, snapshot] = await Promise.all([
    getChampionModel(db),
    getLatestSnapshot(db, address, asOfMs),
  ]);

  if (snapshot.featureSetVersion !== model.featureSetVersion) {
    throw new ApiError(
      409,
      "FEATURE_VERSION_MISMATCH",
      "El snapshot no corresponde a la versión de variables del modelo campeón.",
    );
  }

  let result;
  try {
    result = predict(model, snapshot.features);
  } catch (error: any) {
    throw new ApiError(422, "INFERENCE_INPUT_INVALID", String(error?.message || error));
  }

  const response: EntityScore = {
    address,
    asOf: new Date(asOfMs).toISOString(),
    snapshotAt: new Date(snapshot.snapshotAtMs).toISOString(),
    modelVersion: model.modelVersion,
    featureSetVersion: model.featureSetVersion,
    labelVersion: model.labelVersion,
    predictionHorizonDays: model.horizonDays,
    ...result,
  };

  const predictionId = await recordPrediction(db, {
    entityType: "wallet",
    address,
    asOfMs,
    snapshotId: snapshot.snapshotId,
    modelVersion: model.modelVersion,
    featureSetVersion: model.featureSetVersion,
    labelVersion: model.labelVersion,
    score: result.score,
    probability: result.probability,
    riskLevel: result.riskLevel,
  });

  return {...response, predictionId};
}

export async function scoreTransaction(
  db: admin.firestore.Firestore,
  input: {
    txHash?: unknown;
    from: unknown;
    to: unknown;
    amount?: unknown;
    timestamp?: unknown;
  },
): Promise<object> {
  const from = normalizeTronAddress(input.from);
  const to = normalizeTronAddress(input.to);
  const asOfMs = parseAsOf(input.timestamp);
  const amount = input.amount == null ? null : Number(input.amount);

  if (amount != null && (!Number.isFinite(amount) || amount < 0)) {
    throw new ApiError(400, "INVALID_AMOUNT", "El monto de la transacción no es válido.");
  }

  const [sender, receiver] = await Promise.all([
    scoreWallet(db, {address: from, asOf: asOfMs}),
    scoreWallet(db, {address: to, asOf: asOfMs}),
  ]);

  if (sender.modelVersion !== receiver.modelVersion) {
    throw new ApiError(409, "MODEL_VERSION_MISMATCH", "Las inferencias no usaron el mismo modelo.");
  }

  const transactionScore = Math.max(sender.score, receiver.score);
  const probability = Math.max(sender.probability, receiver.probability);
  const riskLevel = sender.score >= receiver.score ? sender.riskLevel : receiver.riskLevel;
  const predictionId = await recordPrediction(db, {
    entityType: "transaction",
    txHash: input.txHash == null ? null : String(input.txHash),
    from,
    to,
    amount,
    asOfMs,
    modelVersion: sender.modelVersion,
    transactionScore,
    probability,
    riskLevel,
    senderPredictionId: sender.predictionId,
    receiverPredictionId: receiver.predictionId,
  });

  return {
    predictionId,
    txHash: input.txHash == null ? null : String(input.txHash),
    transactionScore,
    probability,
    riskLevel,
    amount,
    asOf: new Date(asOfMs).toISOString(),
    modelVersion: sender.modelVersion,
    featureSetVersion: sender.featureSetVersion,
    labelVersion: sender.labelVersion,
    predictionHorizonDays: sender.predictionHorizonDays,
    aggregation: "MAX_PARTY_PROBABILITY",
    sender,
    receiver,
  };
}
