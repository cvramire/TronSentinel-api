{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./lib",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noImplicitReturns": false,
    "noUnusedLocals": true,
    "noImplicitAny": false
  },
  "compileOnSave": true,
  "include": [
    "./src/**/*",
    "typings/*"
  ]
}