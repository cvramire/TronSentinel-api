#!/usr/bin/env node

import fs from "node:fs";
import fsp from "node:fs/promises";
import path from "node:path";
import readline from "node:readline";
import {parseCsvLine} from "./build-point-in-time-snapshots.mjs";

const DAY_MS = 86_400_000;
const MAX_STABLECOIN_TRANSFER_AMOUNT = 1_000_000_000_000;
const FEATURE_NAMES = [
  "transferCount", "transactionCount", "activeDays", "activeDayRatio", "averageDailyTransfers",
  "inboundCount", "outboundCount", "inboundRatio", "outboundRatio",
  "totalAmount", "inboundAmount", "outboundAmount", "netFlowAmount",
  "meanAmount", "amountStd", "amountCv", "maxAmount",
  "uniqueCounterparties", "uniqueInboundCounterparties", "uniqueOutboundCounterparties",
  "repeatedCounterpartyRatio", "topCounterpartyShare", "counterpartyHhi", "counterpartyEntropy",
  "inboundTopCounterpartyShare", "outboundTopCounterpartyShare", "selfTransferCount", "selfTransferRatio",
  "usdtTransferCount", "tusdTransferCount", "usdtAmount", "tusdAmount",
  "meanInterEventSeconds", "interEventStdSeconds", "interEventCv", "burstiness",
  "observedSpanDays", "daysSinceLastTransfer",
];

function parseArgs(argv) {
  const options = {lookbackDays: 90};
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--wallets") options.wallets = argv[++index];
    else if (arg === "--transfers") options.transfers = argv[++index];
    else if (arg === "--output-dir") options.outputDir = argv[++index];
    else if (arg === "--lookback-days") options.lookbackDays = Number(argv[++index]);
    else throw new Error(`UNKNOWN_ARGUMENT:${arg}`);
  }
  if (!options.wallets || !options.transfers || !options.outputDir) throw new Error("WALLETS_TRANSFERS_OUTPUT_REQUIRED");
  return options;
}

async function readCsv(filePath) {
  const rows = [];
  const reader = readline.createInterface({input: fs.createReadStream(filePath), crlfDelay: Infinity});
  let headers;
  for await (const line of reader) {
    if (!headers) { headers = parseCsvLine(line.replace(/^\uFEFF/, "")); continue; }
    if (!line.trim()) continue;
    const values = parseCsvLine(line);
    rows.push(Object.fromEntries(headers.map((header, index) => [header, values[index] ?? ""])));
  }
  return rows;
}

function csvValue(value) {
  const text = String(value ?? "");
  return /[",\n\r]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text;
}

function safeRatio(numerator, denominator) { return denominator ? numerator / denominator : 0; }
function tokenAmount(record, quality) {
  const raw = Number(record.valueRaw);
  const decimals = Number(record.tokenDecimals || 0);
  const amount = raw / (10 ** decimals);
  if (!Number.isFinite(amount) || amount < 0) {
    quality.invalidAmountEvents += 1;
    return 0;
  }
  if (amount > MAX_STABLECOIN_TRANSFER_AMOUNT) {
    quality.clippedAmountEvents += 1;
    return MAX_STABLECOIN_TRANSFER_AMOUNT;
  }
  return amount;
}

function concentration(values) {
  const total = [...values.values()].reduce((sum, value) => sum + value, 0);
  if (!total) return {top: 0, hhi: 0, entropy: 0};
  const shares = [...values.values()].map((value) => value / total);
  return {
    top: Math.max(...shares),
    hhi: shares.reduce((sum, value) => sum + value ** 2, 0),
    entropy: -shares.reduce((sum, value) => sum + (value > 0 ? value * Math.log(value) : 0), 0),
  };
}

function emptyAccumulator(row) {
  return {
    row, count: 0, inbound: 0, outbound: 0, self: 0,
    total: 0, inboundAmount: 0, outboundAmount: 0, sumSquares: 0, maxAmount: 0,
    transactions: new Set(), days: new Set(), timestamps: [],
    counterparties: new Map(), inboundCounterparties: new Map(), outboundCounterparties: new Map(),
    tokenCount: {USDT: 0, TUSD: 0}, tokenAmount: {USDT: 0, TUSD: 0},
  };
}

function addCounterparty(map, key, amount) { if (key) map.set(key, (map.get(key) || 0) + amount); }

function addRecord(acc, record, quality) {
  const address = acc.row.address;
  const from = String(record.from || "");
  const to = String(record.to || "");
  const amount = tokenAmount(record, quality);
  const inbound = to === address;
  const outbound = from === address;
  const counterparty = inbound && outbound ? address : (inbound ? from : to);
  acc.count += 1;
  acc.inbound += inbound ? 1 : 0;
  acc.outbound += outbound ? 1 : 0;
  acc.self += inbound && outbound ? 1 : 0;
  acc.total += amount;
  acc.inboundAmount += inbound ? amount : 0;
  acc.outboundAmount += outbound ? amount : 0;
  acc.sumSquares += amount ** 2;
  acc.maxAmount = Math.max(acc.maxAmount, amount);
  acc.transactions.add(record.transactionId);
  const timestamp = Number(record.blockTimestamp);
  acc.timestamps.push(timestamp);
  acc.days.add(new Date(timestamp).toISOString().slice(0, 10));
  addCounterparty(acc.counterparties, counterparty, amount || 1);
  if (inbound) addCounterparty(acc.inboundCounterparties, from, amount || 1);
  if (outbound) addCounterparty(acc.outboundCounterparties, to, amount || 1);
  const symbol = String(record.tokenSymbol || "").toUpperCase();
  if (symbol === "USDT" || symbol === "TUSD") {
    acc.tokenCount[symbol] += 1;
    acc.tokenAmount[symbol] += amount;
  }
}

function finalize(acc, lookbackDays) {
  const count = acc.count;
  const mean = safeRatio(acc.total, count);
  const variance = Math.max(0, safeRatio(acc.sumSquares, count) - mean ** 2);
  const std = Math.sqrt(variance);
  const counterparties = concentration(acc.counterparties);
  const inboundConcentration = concentration(acc.inboundCounterparties);
  const outboundConcentration = concentration(acc.outboundCounterparties);
  const times = acc.timestamps.sort((a, b) => a - b);
  const gaps = [];
  for (let index = 1; index < times.length; index += 1) gaps.push((times[index] - times[index - 1]) / 1000);
  const gapMean = safeRatio(gaps.reduce((sum, value) => sum + value, 0), gaps.length);
  const gapVariance = safeRatio(gaps.reduce((sum, value) => sum + (value - gapMean) ** 2, 0), gaps.length);
  const gapStd = Math.sqrt(gapVariance);
  const indexMs = Date.parse(acc.row.indexAtUtc);
  return {
    transferCount: count,
    transactionCount: acc.transactions.size,
    activeDays: acc.days.size,
    activeDayRatio: safeRatio(acc.days.size, lookbackDays),
    averageDailyTransfers: safeRatio(count, lookbackDays),
    inboundCount: acc.inbound,
    outboundCount: acc.outbound,
    inboundRatio: safeRatio(acc.inbound, count),
    outboundRatio: safeRatio(acc.outbound, count),
    totalAmount: acc.total,
    inboundAmount: acc.inboundAmount,
    outboundAmount: acc.outboundAmount,
    netFlowAmount: acc.inboundAmount - acc.outboundAmount,
    meanAmount: mean,
    amountStd: std,
    amountCv: safeRatio(std, mean),
    maxAmount: acc.maxAmount,
    uniqueCounterparties: acc.counterparties.size,
    uniqueInboundCounterparties: acc.inboundCounterparties.size,
    uniqueOutboundCounterparties: acc.outboundCounterparties.size,
    repeatedCounterpartyRatio: safeRatio(count - acc.counterparties.size, count),
    topCounterpartyShare: counterparties.top,
    counterpartyHhi: counterparties.hhi,
    counterpartyEntropy: counterparties.entropy,
    inboundTopCounterpartyShare: inboundConcentration.top,
    outboundTopCounterpartyShare: outboundConcentration.top,
    selfTransferCount: acc.self,
    selfTransferRatio: safeRatio(acc.self, count),
    usdtTransferCount: acc.tokenCount.USDT,
    tusdTransferCount: acc.tokenCount.TUSD,
    usdtAmount: acc.tokenAmount.USDT,
    tusdAmount: acc.tokenAmount.TUSD,
    meanInterEventSeconds: gapMean,
    interEventStdSeconds: gapStd,
    interEventCv: safeRatio(gapStd, gapMean),
    burstiness: safeRatio(gapStd - gapMean, gapStd + gapMean),
    observedSpanDays: times.length > 1 ? (times.at(-1) - times[0]) / DAY_MS : 0,
    daysSinceLastTransfer: times.length ? (indexMs - times.at(-1)) / DAY_MS : lookbackDays,
  };
}

async function main() {
  const options = parseArgs(process.argv.slice(2));
  const allWallets = await readCsv(path.resolve(options.wallets));
  const wallets = allWallets.filter((row) => row.historyStatus === "COMPLETE");
  const walletById = new Map(wallets.map((row) => [row.cohortId, row]));
  const caseDate = new Map(wallets.filter((row) => Number(row.target) === 1).map((row) => [row.matchedCaseId, Date.parse(row.indexAtUtc)]));
  const groups = [...new Set(wallets.map((row) => row.matchedCaseId))].sort((a, b) => (caseDate.get(a) || 0) - (caseDate.get(b) || 0) || a.localeCompare(b));
  const trainEnd = Math.floor(groups.length * 0.70);
  const validationEnd = Math.floor(groups.length * 0.85);
  const splitByGroup = new Map(groups.map((group, index) => [group, index < trainEnd ? "train" : index < validationEnd ? "validation" : "test"]));
  const features = new Map(wallets.map((row) => [row.cohortId, finalize(emptyAccumulator(row), options.lookbackDays)]));
  const quality = {invalidAmountEvents: 0, clippedAmountEvents: 0};
  const reader = readline.createInterface({input: fs.createReadStream(path.resolve(options.transfers)), crlfDelay: Infinity});
  const finishedCohorts = new Set();
  let currentCohort = "";
  let accumulator = null;
  for await (const line of reader) {
    if (!line.trim()) continue;
    const record = JSON.parse(line);
    const row = walletById.get(record.cohortId);
    if (!row) continue;
    if (record.cohortId !== currentCohort) {
      if (accumulator) {
        features.set(currentCohort, finalize(accumulator, options.lookbackDays));
        finishedCohorts.add(currentCohort);
      }
      if (finishedCohorts.has(record.cohortId)) throw new Error(`NON_CONTIGUOUS_COHORT:${record.cohortId}`);
      currentCohort = record.cohortId;
      accumulator = emptyAccumulator(row);
    }
    addRecord(accumulator, record, quality);
  }
  if (accumulator) features.set(currentCohort, finalize(accumulator, options.lookbackDays));

  const outputDir = path.resolve(options.outputDir);
  await fsp.mkdir(outputDir, {recursive: true});
  const metaHeaders = ["cohortId", "matchedCaseId", "address", "indexAtUtc", "datasetSplit", "target"];
  const lines = [[...metaHeaders, ...FEATURE_NAMES].join(",")];
  for (const row of wallets) {
    const feature = features.get(row.cohortId);
    lines.push([
      row.cohortId, row.matchedCaseId, row.address, row.indexAtUtc,
      splitByGroup.get(row.matchedCaseId), Number(row.target),
      ...FEATURE_NAMES.map((name) => feature[name]),
    ].map(csvValue).join(","));
  }
  const datasetPath = path.join(outputDir, "onchain-feature-dataset.csv");
  await fsp.writeFile(datasetPath, `${lines.join("\n")}\n`);
  const splitCounts = {};
  for (const row of wallets) {
    const split = splitByGroup.get(row.matchedCaseId);
    splitCounts[split] ||= {rows: 0, positives: 0, controls: 0};
    splitCounts[split].rows += 1;
    if (Number(row.target) === 1) splitCounts[split].positives += 1; else splitCounts[split].controls += 1;
  }
  const manifest = {
    datasetVersion: "tronsentinel-onchain-features-1.0.0",
    featureSetVersion: "tron-wallet-onchain-1.0.0",
    cohortDesign: "matched-case-control",
    lookbackDays: options.lookbackDays,
    featureNames: FEATURE_NAMES,
    rows: wallets.length,
    positives: wallets.filter((row) => Number(row.target) === 1).length,
    controls: wallets.filter((row) => Number(row.target) === 0).length,
    excludedCensored: allWallets.length - wallets.length,
    amountQuality: {
      maximumTransferAmount: MAX_STABLECOIN_TRANSFER_AMOUNT,
      invalidAmountEvents: quality.invalidAmountEvents,
      clippedAmountEvents: quality.clippedAmountEvents,
    },
    splitUnit: "matchedCaseId",
    splitStrategy: "chronological-70-15-15",
    splits: splitCounts,
    trainingReady: Object.values(splitCounts).every((item) => item.positives > 0 && item.controls > 0),
    generatedAtUtc: new Date().toISOString(),
  };
  await fsp.writeFile(path.join(outputDir, "onchain-feature-manifest.json"), `${JSON.stringify(manifest, null, 2)}\n`);
  process.stdout.write(`${JSON.stringify({ok: true, outputDir, ...manifest}, null, 2)}\n`);
}

main().catch((error) => { process.stderr.write(`${error?.stack || error}\n`); process.exitCode = 1; });
