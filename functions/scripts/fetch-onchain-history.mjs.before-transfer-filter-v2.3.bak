#!/usr/bin/env node

import crypto from "node:crypto";
import fs from "node:fs";
import fsp from "node:fs/promises";
import path from "node:path";
import readline from "node:readline";
import {parseCsvLine} from "./build-point-in-time-snapshots.mjs";

const CONTRACTS = [
  "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t",
  "TUpMhErZL2fhh4sVNULAbNKLokS4GjC1F4",
];
const DAY_MS = 86_400_000;
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

function parseArgs(argv) {
  const options = {lookbackDays: 90, pageSize: 200, maxPages: 50, delayMs: 250, maxRetries: 6};
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--cohort") options.cohort = argv[++index];
    else if (arg === "--output-dir") options.outputDir = argv[++index];
    else if (arg === "--lookback-days") options.lookbackDays = Number(argv[++index]);
    else if (arg === "--page-size") options.pageSize = Number(argv[++index]);
    else if (arg === "--max-pages") options.maxPages = Number(argv[++index]);
    else if (arg === "--delay-ms") options.delayMs = Number(argv[++index]);
    else if (arg === "--max-retries") options.maxRetries = Number(argv[++index]);
    else if (arg === "--max-wallets") options.maxWallets = Number(argv[++index]);
    else if (arg === "--dry-run") options.dryRun = true;
    else throw new Error(`UNKNOWN_ARGUMENT:${arg}`);
  }
  if (!options.cohort || !options.outputDir) throw new Error("COHORT_AND_OUTPUT_REQUIRED");
  if (!Number.isInteger(options.pageSize) || options.pageSize < 20 || options.pageSize > 200) throw new Error("PAGE_SIZE_20_TO_200");
  return options;
}

async function readCsv(filePath) {
  const reader = readline.createInterface({input: fs.createReadStream(filePath), crlfDelay: Infinity});
  let headers;
  const rows = [];
  for await (const line of reader) {
    if (!headers) { headers = parseCsvLine(line.replace(/^\uFEFF/, "")); continue; }
    if (!line.trim()) continue;
    const values = parseCsvLine(line);
    rows.push(Object.fromEntries(headers.map((header, index) => [header, values[index] ?? ""])));
  }
  return rows;
}

async function loadNdjson(filePath) {
  const result = [];
  try {
    const reader = readline.createInterface({input: fs.createReadStream(filePath), crlfDelay: Infinity});
    for await (const line of reader) if (line.trim()) result.push(JSON.parse(line));
  } catch (error) { if (error?.code !== "ENOENT") throw error; }
  return result;
}

async function requestJson(url, key, retries) {
  let lastError;
  for (let attempt = 0; attempt <= retries; attempt += 1) {
    try {
      const response = await fetch(url, {headers: {accept: "application/json", "TRON-PRO-API-KEY": key}});
      const text = await response.text();
      let body;
      try { body = text ? JSON.parse(text) : {}; } catch { body = {raw: text.slice(0, 500)}; }
      if (response.ok && body.success !== false) return body;
      const retryable = response.status === 429 || response.status >= 500;
      if (!retryable || attempt === retries) throw new Error(`HTTP ${response.status}: ${JSON.stringify(body).slice(0, 500)}`);
      const suspended = Number(JSON.stringify(body).match(/suspended for (\d+) s/i)?.[1] || 0) * 1000;
      const retryAfter = Number(response.headers.get("retry-after") || 0) * 1000;
      await sleep(Math.max(suspended, retryAfter, 500 * (2 ** attempt)) + Math.floor(Math.random() * 250));
    } catch (error) {
      lastError = error;
      if (attempt === retries) break;
      await sleep(500 * (2 ** attempt) + Math.floor(Math.random() * 250));
    }
  }
  throw lastError || new Error("REQUEST_FAILED");
}

async function fetchContractHistory(row, contract, options, key) {
  const maxTimestamp = Date.parse(row.indexAtUtc) - 1;
  const minTimestamp = maxTimestamp - options.lookbackDays * DAY_MS;
  const transactions = [];
  let fingerprint = "";
  let pages = 0;
  let truncated = false;
  do {
    const url = new URL(`https://api.trongrid.io/v1/accounts/${encodeURIComponent(row.address)}/transactions/trc20`);
    url.searchParams.set("only_confirmed", "true");
    url.searchParams.set("limit", String(options.pageSize));
    url.searchParams.set("order_by", "block_timestamp,asc");
    url.searchParams.set("min_timestamp", String(minTimestamp));
    url.searchParams.set("max_timestamp", String(maxTimestamp));
    url.searchParams.set("contract_address", contract);
    if (fingerprint) url.searchParams.set("fingerprint", fingerprint);
    const body = await requestJson(url, key, options.maxRetries);
    pages += 1;
    for (const item of Array.isArray(body.data) ? body.data : []) transactions.push(item);
    fingerprint = String(body.meta?.fingerprint || "");
    if (fingerprint && pages >= options.maxPages) { truncated = true; break; }
    if (fingerprint && options.delayMs) await sleep(options.delayMs);
  } while (fingerprint);
  return {transactions, pages, truncated, minTimestamp, maxTimestamp};
}

async function main() {
  const options = parseArgs(process.argv.slice(2));
  const key = process.env.APP_TRONGRID_API_KEY || process.env.TRONGRID_API_KEY;
  if (!options.dryRun && !key) throw new Error("Falta APP_TRONGRID_API_KEY o TRONGRID_API_KEY");
  let cohort = await readCsv(path.resolve(options.cohort));
  if (Number.isInteger(options.maxWallets) && options.maxWallets > 0) cohort = cohort.slice(0, options.maxWallets);
  const outputDir = path.resolve(options.outputDir);
  await fsp.mkdir(outputDir, {recursive: true});
  const plan = {wallets: cohort.length, contracts: CONTRACTS, lookbackDays: options.lookbackDays, pageSize: options.pageSize, maxPagesPerContract: options.maxPages};
  await fsp.writeFile(path.join(outputDir, "onchain-history-plan.json"), JSON.stringify(plan, null, 2) + "\n");
  if (options.dryRun) { process.stdout.write(JSON.stringify({ok: true, dryRun: true, outputDir, ...plan}, null, 2) + "\n"); return; }
  const transfersPath = path.join(outputDir, "onchain-transfers.ndjson");
  const statusPath = path.join(outputDir, "onchain-wallet-status.ndjson");
  const existing = await loadNdjson(statusPath);
  const completed = new Set(existing.filter((item) => item.ok && !item.truncated).map((item) => item.cohortId));
  let processed = 0;
  for (const row of cohort) {
    if (completed.has(row.cohortId)) continue;
    try {
      const normalized = [];
      let pages = 0;
      let truncated = false;
      for (const contract of CONTRACTS) {
        const result = await fetchContractHistory(row, contract, options, key);
        pages += result.pages;
        truncated ||= result.truncated;
        for (const item of result.transactions) {
          const record = {
            cohortId: row.cohortId, matchedCaseId: row.matchedCaseId,
            address: row.address, target: Number(row.target), indexAtUtc: row.indexAtUtc,
            transactionId: item.transaction_id || "", blockTimestamp: Number(item.block_timestamp || 0),
            from: item.from || "", to: item.to || "", valueRaw: String(item.value ?? ""),
            tokenAddress: item.token_info?.address || contract,
            tokenSymbol: item.token_info?.symbol || "", tokenDecimals: Number(item.token_info?.decimals || 0),
            type: item.type || "Transfer",
          };
          record.eventId = crypto.createHash("sha256").update(JSON.stringify(record)).digest("hex");
          normalized.push(record);
        }
        if (options.delayMs) await sleep(options.delayMs);
      }
      const unique = new Map(normalized.map((item) => [item.eventId, item]));
      for (const item of unique.values()) await fsp.appendFile(transfersPath, JSON.stringify(item) + "\n");
      const status = {cohortId: row.cohortId, address: row.address, ok: true, truncated, pages, transfers: unique.size, completedAtUtc: new Date().toISOString()};
      await fsp.appendFile(statusPath, JSON.stringify(status) + "\n");
      processed += 1;
      process.stdout.write(`${completed.size + processed}/${cohort.length} ${row.address} transfers=${unique.size} pages=${pages}${truncated ? " TRUNCATED" : ""}\n`);
    } catch (error) {
      await fsp.appendFile(statusPath, JSON.stringify({cohortId: row.cohortId, address: row.address, ok: false, error: String(error?.message || error), completedAtUtc: new Date().toISOString()}) + "\n");
      process.stdout.write(`${completed.size + processed + 1}/${cohort.length} ${row.address} ERROR\n`);
    }
  }
  const latest = new Map();
  for (const item of await loadNdjson(statusPath)) latest.set(item.cohortId, item);
  const statuses = [...latest.values()];
  const summary = {
    ...plan, completed: statuses.filter((item) => item.ok).length,
    errors: statuses.filter((item) => !item.ok).length,
    truncated: statuses.filter((item) => item.truncated).length,
    transfers: statuses.reduce((sum, item) => sum + Number(item.transfers || 0), 0),
    trainingSafe: statuses.length === cohort.length && statuses.every((item) => item.ok && !item.truncated),
    generatedAtUtc: new Date().toISOString(),
  };
  await fsp.writeFile(path.join(outputDir, "onchain-history-summary.json"), JSON.stringify(summary, null, 2) + "\n");
  process.stdout.write(JSON.stringify({ok: true, outputDir, ...summary}, null, 2) + "\n");
}

main().catch((error) => { process.stderr.write(`${error?.stack || error}\n`); process.exitCode = 1; });
