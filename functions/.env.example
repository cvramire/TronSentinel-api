# TronSentinel uses a Firebase project independent from Wallet Alert.
APP_PROJECT_ID=pry-tronsentinel

# Public TRON data source used to construct point-in-time features.
APP_TRONGRID_API_KEY=replace-with-secret-manager-value

# Administrative operations such as importing labels and training models.
APP_RISK_ADMIN_SECRET=replace-with-a-long-random-secret

# SHA-256 hexadecimal de la clave enviada mediante el encabezado x-api-key.
APP_API_KEY_SHA256=replace-with-64-character-sha256

# Non-secret model configuration.
APP_MODEL_CACHE_MS=300000
APP_PREDICTION_HORIZON_DAYS=90
APP_MATURITY_MARGIN_DAYS=30
APP_TZ_OFFSET=-5
